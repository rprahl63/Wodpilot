# ─── Required ────────────────────────────────────────────────────────────────
TELEGRAM_TOKEN=your-bot-token-from-botfather
ADMIN_TELEGRAM_ID=123456789

# Supabase (service_role key – never expose client-side)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Encryption key for Garmin passwords and LLM API keys
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-fernet-key-here

# ─── Web UI ───────────────────────────────────────────────────────────────────
WEB_SECRET_KEY=change-this-random-string
WEB_ADMIN_PASSWORD=change-this-password
DOMAIN=admin.wodpilot.app

# ─── Let's Encrypt ────────────────────────────────────────────────────────────
ACME_EMAIL=your@email.com

# ─── Optional ─────────────────────────────────────────────────────────────────
# OpenAI key for embeddings (text-embedding-3-small)
OPENAI_API_KEY=sk-...

# GitHub container registry owner (lowercase)
GITHUB_OWNER=your-github-username

# Default LLM model (users can override with their own)
DEFAULT_LLM_MODEL=claude-sonnet-4-20250514

# Rate limiting (API calls per user per day)
MAX_API_CALLS_PER_DAY=50

# Cron schedules (default: Garmin sync 05:00, WOD scrape 05:30, Briefing 07:00)
GARMIN_SYNC_CRON=0 5 * * *
WOD_SCRAPE_CRON=30 5 * * *
MORNING_BRIEFING_CRON=0 7 * * *

# ─── Pi-Agent Microservice ────────────────────────────────────────────────────
# Internal API token – shared secret between web service and pi-agent service
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_TOKEN=change-this-random-token

# Pi-agent service URL (only override in non-Docker local development)
# PI_AGENT_URL=http://localhost:3001
