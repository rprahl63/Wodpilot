# Environment
# ".env" matches only that exact name and "*.env" only names ending in .env,
# so siblings like .env.generated slipped through and would have been
# committed with every secret in them. Ignore the whole family instead and
# allow the template back in explicitly.
.env
.env.*
*.env
!.env.example

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Docker
*.log

# Data
/data/
*.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Terraform
terraform/.terraform/
terraform/.terraform.lock.hcl
terraform/tfplan
terraform/*.tfvars
# terraform.tfstate is committed intentionally (local state backend)

# Node.js (pi-agent-service)
pi-agent-service/node_modules/
pi-agent-service/dist/
