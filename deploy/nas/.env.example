# WODpilot NAS configuration.
#
# Generate the secret block with:  bash gen-secrets.sh
# Then fill in the values below it by hand.

# ─── Generated secrets (from gen-secrets.sh) ─────────────────────────────────
JWT_SECRET=
SUPABASE_SERVICE_KEY=
POSTGRES_PASSWORD=
AUTHENTICATOR_PASSWORD=
INTERNAL_API_TOKEN=
WEB_SECRET_KEY=
ENCRYPTION_KEY=

# ─── Network ─────────────────────────────────────────────────────────────────
# The NAS's NetBird overlay IP. Dashboard and chat bind here and nowhere else,
# so they are unreachable from the LAN and from the internet.
# Verify with: docker exec netbird netbird status | grep "NetBird IP"
BIND_IP=100.x.x.x

# ─── Telegram ────────────────────────────────────────────────────────────────
TELEGRAM_TOKEN=
ADMIN_TELEGRAM_ID=

# ─── Web UI ──────────────────────────────────────────────────────────────────
WEB_ADMIN_PASSWORD=

# ─── LLM ─────────────────────────────────────────────────────────────────────
# Embeddings run through Requesty too. 3-large is requested at 1536 dimensions
# so it fits the existing vector(1536) column; it beats 3-small clearly on
# German queries against English-stored memories.
# Normally the per-user key is used; this is only a service-wide fallback.
REQUESTY_API_KEY=
REQUESTY_BASE_URL=https://router.requesty.ai/v1
EMBEDDING_MODEL=openai/text-embedding-3-large
DEFAULT_LLM_MODEL=anthropic/claude-sonnet-4-5
MAX_API_CALLS_PER_DAY=50
# Speech-to-text for voice messages – also billed against the user's Requesty key
TRANSCRIPTION_MODEL=openai/gpt-4o-mini-transcribe

# ─── Athlete dashboard ───────────────────────────────────────────────────────
# Only set this to override the default http://${BIND_IP}:8080 from the compose
# file — e.g. when reaching the dashboard through a different hostname.
# DASHBOARD_BASE_URL=
LOGIN_TOKEN_TTL_MINUTES=15

# ─── Schedules ───────────────────────────────────────────────────────────────
GARMIN_SYNC_CRON=0 5 * * *
WOD_SCRAPE_CRON=30 5 * * *
MORNING_BRIEFING_CRON=0 7 * * *
WEEKLY_PLAN_ASK_CRON=0 10 * * sun
WEEKLY_PLAN_FALLBACK_CRON=0 18 * * sun

# ─── Not used in this deployment ─────────────────────────────────────────────
# DOMAIN / ACME_EMAIL / GITHUB_OWNER are Traefik + registry settings from the
# upstream VPS setup. The NAS build is local and has no public entrypoint.
